# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Neon provides two URLs: pooled (for app queries) and direct (for migrations)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Upstash Redis (for distributed locking + idempotency)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Reservation window in minutes (default: 10)
RESERVATION_TTL_MINUTES=10

# Cron secret — used to authenticate the /api/cron/expire-reservations endpoint
CRON_SECRET="your-secret-here"
